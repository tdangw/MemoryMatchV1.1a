{
  "name": "memory-match-adventure",
  "version": "1.1.0-a",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build --base=/",
    "build:gh-pages": "vite build --base=/MemoryMatchV1.1a/",
    "deploy": "npm run build && firebase deploy --only hosting",
    "deploy:gh-pages": "npm run build:gh-pages && gh-pages -d dist --add",
    "preview": "vite preview",
    "check": "node scripts/check-js.mjs",
    "android:add": "cap add android",
    "android:sync": "npm run build && cap sync android",
    "android:open": "cap open android",
    "android:apk": "npm run android:sync && cd android && gradlew.bat assembleDebug",
    "android:aab": "npm run android:sync && cd android && gradlew.bat bundleRelease"
  },
  "dependencies": {
    "@capacitor-community/admob": "^8.1.0",
    "@capacitor/android": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "canvas-confetti": "^1.9.4",
    "firebase": "^12.18.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "firebase-tools": "^15.28.1",
    "gh-pages": "^6.3.0",
    "vite": "^6.4.3"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
