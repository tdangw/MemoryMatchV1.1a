          && n.spins.ads.hasAll(o.spins.ads) && n.spins.ads.size() <= o.spins.ads.size() + 1
          && (n.spins.ads.size() == o.spins.ads.size() || n.spins.ads.removeAll(o.spins.ads) == [n.spins.ads[n.spins.ads.size()-1]]))
        && (sameDay || n.spins.ads.size() <= 1)
        && (!sameDay || n.spins.pastAds.hasAll(o.spins.pastAds));
