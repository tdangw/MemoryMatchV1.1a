    }
    function letterRequirement(setId,key) { return setId == 'memory-match' ? {"M":3,"E":1,"O":1,"R":1,"Y":1,"A":1,"T":1,"C":1,"H":1}.get(key,0) : setId == 'link-connect' ? {"L":1,"I":1,"N":3,"K":1,"C":2,"O":1,"E":1,"T":1}.get(key,0) : setId == 'triple-connect' ? {"T":2,"R":1,"I":1,"P":1,"L":1,"E":2,"C":2,"O":1,"N":2}.get(key,0) : setId == 'adventure' ? {"A":1,"D":1,"V":1,"E":2,"N":1,"T":1,"U":1,"R":1}.get(key,0) : 0; }
    function rewardLetterValue(n,o,key) {
      let amount = n.counts.get(key,0);
      let earned = n.earned.get(key,0);
      let oldEarned = o.earned.get(key,0);
      let exchange = n.sequence != o.sequence;
      let spent = !exchange ? 0 : n.last.kind == 'exchange' ? letterRequirement(n.last.setId,key) : n.last.letter == key ? (n.last.kind == 'sell' ? n.last.quantity : 3) : 0;
      let produced = exchange && n.last.kind == 'fuse' && n.last.received == key ? 1 : 0;
      return amount is int && amount >= 0 && amount <= 9007199254740991
        && earned is int && earned >= oldEarned && earned <= 9007199254740991
        && amount == o.counts.get(key,0) + earned - oldEarned - spent + produced;
    }
    function rewardLetters(n,o) {
      let changed = n.counts.diff(o.counts).affectedKeys().union(n.earned.diff(o.earned).affectedKeys());
      return n.keys().hasOnly(['counts','earned','sequence','last']) && n.counts is map && n.earned is map
        && n.counts.keys().hasOnly(['A','C','D','E','H','I','K','L','M','N','O','P','R','T','U','V','Y']) && n.earned.keys().hasOnly(['A','C','D','E','H','I','K','L','M','N','O','P','R','T','U','V','Y'])
        && n.sequence is int && n.sequence >= o.sequence && n.sequence <= o.sequence + 1
        && (n.sequence == o.sequence ? n.last == o.last : n.last is map
          && n.last.keys().hasOnly(['kind','letter','quantity','coins','received','sequence','operation','setId','itemId'])
