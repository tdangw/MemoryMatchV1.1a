rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function knownSpace(space) { return space in ['production', 'beta', 'test', 'local', 'production-waves1', 'beta-waves1', 'test-waves1', 'local-waves1']; }
    function owner(uid) { return request.auth != null && request.auth.uid == uid; }
    function statisticsAdmin() { return request.auth != null && request.auth.token.admin == true; }
    function validStatistics(data) {
      return data.keys().hasOnly(['version', 'counterId', 'counters', 'totalPlayMs', 'trackedSince', 'updatedAt'])
        && data.keys().hasAll(['version', 'counterId', 'counters', 'totalPlayMs', 'trackedSince', 'updatedAt'])
        && data.counterId is string && data.counterId.matches('^[a-f0-9-]{36}$')
        && data.version == 1 && data.counters is map && data.counters.size() > 0 && data.counters.size() <= 128
        && data.totalPlayMs is int && data.totalPlayMs >= 0 && data.totalPlayMs <= 9007199254740991
        && data.trackedSince is int && data.trackedSince > 0 && data.trackedSince <= request.time.toMillis()
        && data.updatedAt == request.time;
    }
    function validCounterChange(next, previous) {
      let changed = next.counters.diff(previous.counters).affectedKeys();
      let key = next.counterId;
      let old = previous.counters.get(key, 0);
      let value = next.counters.get(key, -1);
      return changed.size() == 1 && changed.hasOnly([key])
        && value is int && value >= old && value <= 9007199254740991
        && next.totalPlayMs == previous.totalPlayMs + value - old
        && next.trackedSince <= previous.trackedSince;
    }
    match /gamespaces/{space}/profileStats/{uid} {
      allow get: if knownSpace(space) && (owner(uid) || statisticsAdmin());
      allow list: if knownSpace(space) && statisticsAdmin() && request.query.limit != null && request.query.limit <= 100;
      allow create: if knownSpace(space) && owner(uid) && validStatistics(request.resource.data)
        && request.resource.data.counters.size() == 1
        && validCounterChange(request.resource.data, {'counters': {}, 'totalPlayMs': 0, 'trackedSince': request.resource.data.trackedSince});
      allow update: if knownSpace(space) && owner(uid) && validStatistics(request.resource.data)
        && validCounterChange(request.resource.data, resource.data);
      allow delete: if false;
    }
    function validRoot(data) {
      return data.keys().hasOnly(['snapshotVersion', 'formatVersion', 'revision', 'manifest', 'fingerprint', 'byteLength', 'playerName', 'updatedAt', 'rewardRevision', 'economyRevision'])
        && data.keys().hasAll(['snapshotVersion', 'formatVersion', 'revision', 'manifest', 'fingerprint', 'byteLength', 'playerName', 'updatedAt'])
        && data.snapshotVersion == 1 && data.formatVersion == 2
        && data.revision is int && data.revision > 0
        && data.manifest is map && data.manifest.profile is list && data.manifest.profile.size() > 0
        && data.fingerprint is string && data.fingerprint.matches('^[a-f0-9]{64}$')
        && data.get('economyRevision',0) is int && data.get('economyRevision',0) >= 0 && data.get('economyRevision',0) <= 9007199254740991
        && data.byteLength is int && data.byteLength > 0 && data.byteLength <= 134217728
        && data.playerName is string && data.playerName.size() > 0 && data.playerName.size() <= 40
        && data.updatedAt == request.time;
    }
    function validObject(data, hash) {
      return hash.matches('^[a-f0-9]{64}$')
        && data.keys().hasOnly(['snapshotVersion', 'payload', 'byteLength', 'stageId', 'createdAt'])
        && data.keys().hasAll(['snapshotVersion', 'payload', 'byteLength', 'stageId', 'createdAt'])
        && data.snapshotVersion == 1 && data.payload is string && data.payload.size() > 0 && data.payload.size() <= 90000
        && data.byteLength is int && data.byteLength > 0 && data.byteLength <= 65536
        && data.stageId is string && data.stageId.matches('^[a-f0-9-]{36}$') && data.createdAt == request.time;
    }
    match /gamespaces/{space}/players/{uid} {
      allow get: if knownSpace(space) && owner(uid);
      allow list, delete: if false;
      allow create: if knownSpace(space) && owner(uid) && validRoot(request.resource.data) && request.resource.data.revision == 1 && rewardRootLink(space, uid);
      allow update: if knownSpace(space) && owner(uid) && validRoot(request.resource.data)
        && request.resource.data.revision == resource.data.revision + 1 && rewardRootLink(space, uid)
        && request.resource.data.get('economyRevision',0) >= resource.data.get('economyRevision',0);
      match /objects/{hash} {
        allow get: if knownSpace(space) && owner(uid);
        allow list: if false;
        allow create: if knownSpace(space) && owner(uid) && validObject(request.resource.data, hash);
        allow update: if knownSpace(space) && owner(uid) && validObject(request.resource.data, hash)
          && request.resource.data.payload == resource.data.payload && request.resource.data.byteLength == resource.data.byteLength;
        allow delete: if knownSpace(space) && owner(uid);
      }
    }
    function validEntry(data, board) {
      return data.rulesVersion == 3 ? validProgressEntry(data, board) : data.rulesVersion in [1, 2] && data.resultId is string && data.resultId.matches('^[a-f0-9-]{36}$')
        && data.gameId in ['memory-match', 'link-connect', 'triple-connect']
        && data.playerName is string && data.playerName.size() > 0 && data.playerName.size() <= 40
        && data.updatedAt == request.time
        && (data.kind == 'time'
          ? data.rulesVersion == 1 && data.keys().hasOnly(['rulesVersion', 'resultId', 'gameId', 'mode', 'kind', 'playerName', 'updatedAt', 'level', 'durationMs', 'score', 'stars'])
            && data.mode in ['easy', 'normal', 'hard', 'superHard']
            && data.level is int && data.level > 0 && data.level <= 9007199254740900
            && board == 'v1_' + data.gameId + '_' + data.mode + '_' + string(data.level)
            && data.durationMs is int && data.durationMs > 0 && data.durationMs <= 9007199254740991
            && data.score is int && data.score >= 0 && data.score <= 9007199254740991
            && data.stars is int && data.stars >= 0 && data.stars <= 3
          : data.kind == 'run' && data.keys().hasOnly(['rulesVersion', 'resultId', 'gameId', 'mode', 'kind', 'playerName', 'updatedAt', 'levelReached', 'totalScore', 'outcome'])
            && (data.mode == 'challenge' || data.mode == 'endless' && (data.rulesVersion == 2 || data.gameId == 'triple-connect'))
            && board == 'v' + string(data.rulesVersion) + '_' + data.gameId + '_' + data.mode
            && data.levelReached is int && data.levelReached > 0 && data.levelReached <= 9007199254740991
            && data.totalScore is int && data.totalScore >= 0 && data.totalScore <= 9007199254740991
            && (data.rulesVersion == 2 ? data.outcome == 'won' : data.outcome in ['won', 'lost']));
    }
    function validProgressEntry(data, board) {
      return data.keys().hasOnly(['rulesVersion', 'resultId', 'gameId', 'family', 'kind', 'playerName', 'reachedAt', 'levelReached'])
        && data.keys().hasAll(['rulesVersion', 'resultId', 'gameId', 'family', 'kind', 'playerName', 'reachedAt', 'levelReached'])
        && data.resultId is string && data.resultId.matches('^[a-f0-9-]{36}$') && data.kind == 'progress'
        && data.gameId in ['memory-match', 'link-connect', 'triple-connect'] && data.family in ['adventure', 'challenge', 'endless']
        && board == 'v3_' + data.gameId + '_' + data.family
        && data.playerName is string && data.playerName.size() > 0 && data.playerName.size() <= 40
        && data.levelReached is int && data.levelReached > 0 && data.levelReached <= 9007199254740900
        && data.reachedAt == request.time;
    }
    function betterEntry(next, previous) {
      return next.kind == previous.kind && (next.kind == 'progress' ? next.levelReached > previous.levelReached : next.kind == 'time' ? next.durationMs < previous.durationMs
        : next.levelReached > previous.levelReached || next.levelReached == previous.levelReached && next.totalScore > previous.totalScore);
    }
    match /gamespaces/{space}/leaderboards/{board}/entries/{uid} {
      allow get: if knownSpace(space);
      // Approved 26/10: exact personal rank counts the public ordered prefix.
      // Firestore uses the same permission for document and aggregation queries.
      allow list: if knownSpace(space) && ((request.query.limit != null && request.query.limit <= 20)
        || (request.auth != null && request.query.limit == null));
      allow create: if knownSpace(space) && owner(uid) && validEntry(request.resource.data, board);
      allow update: if knownSpace(space) && owner(uid) && validEntry(request.resource.data, board) && betterEntry(request.resource.data, resource.data);
      allow delete: if false;
    }
    // BEGIN generated public cosmetic contract
    function validPublicCosmetics(data) {
      return data.keys().hasOnly(['version', 'avatar', 'frame', 'badge', 'updatedAt'])
        && data.keys().hasAll(['version', 'avatar', 'frame', 'badge', 'updatedAt'])
        && data.version == 1 && data.updatedAt == request.time
        && (data.avatar == null || data.avatar in ['starter-avatar-little-sparrow', 'memory-avatar-sapphire-owl', 'memory-avatar-cherry-rabbit', 'memory-avatar-stellar-cat', 'memory-avatar-scholar-squirrel', 'memory-avatar-stargazer-hedgehog', 'memory-avatar-dreaming-deer', 'memory-avatar-galaxy-whale', 'memory-avatar-chestnut-squirrel', 'memory-avatar-snow-rabbit', 'memory-avatar-honey-bear', 'memory-avatar-dawn-crane', 'link-avatar-autumn-fox', 'link-avatar-moonfox', 'link-avatar-galaxy-deer', 'link-avatar-sailor-beaver', 'link-avatar-pearl-dolphin', 'link-avatar-azure-turtle', 'link-avatar-royal-seahorse', 'link-avatar-lantern-cat', 'link-avatar-festival-sparrow', 'link-avatar-paperblossom-deer', 'link-avatar-glasslight-fox', 'triple-avatar-jade-dragon', 'triple-avatar-blue-panda', 'triple-avatar-sunset-dragon', 'triple-avatar-quartz-phoenix', 'triple-avatar-amethyst-unicorn', 'triple-avatar-platinum-dragon', 'triple-avatar-crystal-mech-cat', 'triple-avatar-aurora-snowfox', 'triple-avatar-jade-penguin', 'triple-avatar-polar-bear', 'triple-avatar-galactic-dragon', 'event-avatar-lantern-otter', 'letters-memory-avatar-moss-redpanda', 'letters-link-avatar-flower-fox', 'letters-triple-avatar-rose-dragon', 'letters-royal-avatar-dawn-lion'])
        && (data.frame == null || data.frame in ['starter-frame-plain-wood', 'memory-frame-golden-laurel', 'memory-frame-cherry-blossom', 'memory-frame-sky-feather', 'memory-frame-gilded-pages', 'memory-frame-astral-orbit', 'memory-frame-silken-clouds', 'memory-frame-knowledge-gateway', 'memory-frame-autumn-leaves', 'memory-frame-frosted-branch', 'memory-frame-golden-honeycomb', 'memory-frame-memory-crown', 'link-frame-moonblossom', 'link-frame-silver-moon', 'link-frame-stellar-orbit', 'link-frame-moon-coral', 'link-frame-silver-waves', 'link-frame-pearl-shell', 'link-frame-tidal-crown', 'link-frame-silk-lanterns', 'link-frame-osmanthus-branch', 'link-frame-moon-silk', 'link-frame-lantern-moon-gate', 'triple-frame-tri-crystal', 'triple-frame-prism', 'triple-frame-emerald', 'triple-frame-crystal-arch', 'triple-frame-three-wing-star', 'triple-frame-jade-gears', 'triple-frame-tri-star-crown', 'triple-frame-aurora-ribbon', 'triple-frame-azure-ice-ring', 'triple-frame-silver-meteor', 'triple-frame-aurora-crown', 'event-frame-firefly-glow', 'letters-memory-frame-memory-leaves', 'letters-link-frame-silk-lantern', 'letters-triple-frame-prism-glass', 'letters-royal-frame-journey-crown'])
        && (data.badge == null || data.badge in ['starter-badge-first-leaf', 'memory-badge-wisdom', 'memory-badge-memory-master', 'memory-badge-wisdom-seal', 'memory-badge-memory-keeper', 'memory-badge-four-seasons', 'memory-badge-forest-guardian', 'link-badge-link-master', 'link-badge-golden-bond', 'link-badge-lighthouse-guide', 'link-badge-ocean-knot', 'link-badge-guiding-lantern', 'link-badge-moonlit-promise', 'triple-badge-crystal-triad', 'triple-badge-triad-master', 'triple-badge-triangle-seal', 'triple-badge-crystal-keeper', 'triple-badge-three-dawn-rays', 'triple-badge-aurora-heart', 'letters-memory-badge-folded-leaf', 'letters-link-badge-wish-knot', 'letters-triple-badge-prism-heart', 'letters-royal-badge-royal-seal']);
    }
    match /gamespaces/{space}/publicCosmetics/{uid} {
      allow get: if knownSpace(space);
      allow list: if knownSpace(space) && request.query.limit != null && request.query.limit <= 20;
      allow create, update: if knownSpace(space) && owner(uid) && validPublicCosmetics(request.resource.data);
      allow delete: if false;
    }
    // END generated public cosmetic contract
    // BEGIN Spark reward contract
    function emptyChestCounts() { return {'c':0,'frame':0,'avatar':0,'badge':0}; }
    function emptyChests() { return {'version':1,'earned':emptyChestCounts(),'spent':emptyChestCounts(),'sourceEarned':emptyChestCounts(),'sequence':0,'last':null}; }
    function emptyFestival() { return {'version':1,'earnedTotal':0,'completedCycles':0,'mask':0}; }
    function chestCountMap(n) {
      return n is map && n.keys().hasOnly(['c','frame','avatar','badge']) && n.keys().hasAll(['c','frame','avatar','badge'])
        && rewardInt(n.c) && rewardInt(n.frame) && rewardInt(n.avatar) && rewardInt(n.badge);
    }
    function chestCounts(n) {
      return n.keys().hasOnly(['version','earned','spent','sourceEarned','sequence','last']) && n.version == 1
        && chestCountMap(n.earned) && chestCountMap(n.spent) && chestCountMap(n.sourceEarned) && rewardInt(n.sequence)
        && n.spent.c <= n.earned.c && n.spent.frame <= n.earned.frame && n.spent.avatar <= n.earned.avatar && n.spent.badge <= n.earned.badge
        && n.sequence == n.spent.c + n.spent.frame + n.spent.avatar + n.spent.badge;
    }
    function festivalValid(n) {
      return n.keys().hasOnly(['version','earnedTotal','completedCycles','mask']) && n.version == 1
        && rewardInt(n.earnedTotal) && rewardInt(n.completedCycles) && n.earnedTotal >= n.completedCycles * 100
        && n.mask is int && n.mask >= 0 && n.mask < 15
        && (n.mask % 2 == 0 || n.earnedTotal - n.completedCycles * 100 >= 25)
        && (int(n.mask / 2) % 2 == 0 || n.earnedTotal - n.completedCycles * 100 >= 50)
        && (int(n.mask / 4) % 2 == 0 || n.earnedTotal - n.completedCycles * 100 >= 75)
        && (int(n.mask / 8) % 2 == 0 || n.earnedTotal - n.completedCycles * 100 >= 100);
    }
    function chestBase(n,o,fields) {
      return n.diff(o).affectedKeys().hasOnly(fields.concat(['revision','rootRevision','fingerprint','updatedAt']))
        && n.revision == o.revision + 1 && n.updatedAt == request.time && n.day == int(request.time.toMillis() / 86400000);
    }
    function rewardChestInit(n,o) {
      return !o.keys().hasAny(['chests','festival']) && chestBase(n,o,['chests','festival'])
        && n.chests == emptyChests() && n.festival == emptyFestival();
    }
    function chestGain(n,o,type) {
      return n.version == o.version && n.sourceEarned == o.sourceEarned && n.spent == o.spent && n.last == o.last && n.sequence == o.sequence
        && n.earned.diff(o.earned).affectedKeys().hasOnly([type]) && rewardInt(n.earned[type]) && n.earned[type] == o.earned[type] + 1;
    }
    function chestForSet(id) { return id == 'memory-match' ? 'avatar' : id == 'link-connect' ? 'frame' : id == 'triple-connect' ? 'badge' : id == 'adventure' ? 'avatar' : ''; }
    function rewardChestExchange(n,o) {
      return chestBase(n,o,['chests','letters']) && n.letters.last.get('chestType','') == chestForSet(n.letters.last.setId)
        && rewardLetterExchange(n.letters,o.letters) && chestGain(n.chests,o.chests,n.letters.last.chestType);
    }
    function rewardFestivalEarn(n,o) {
      return chestBase(n,o,['festival']) && festivalValid(n.festival) && n.festival.completedCycles == o.festival.completedCycles
        && n.festival.mask == o.festival.mask && n.festival.earnedTotal >= o.festival.earnedTotal;
    }
    function rewardFestivalClaim(n,o) {
      let prior = o.festival;
      let next = n.festival;
      let delta = next.completedCycles == prior.completedCycles ? next.mask - prior.mask : 15 - prior.mask;
      let threshold = delta == 1 ? 25 : delta == 2 ? 50 : delta == 4 ? 75 : 100;
      let type = delta == 2 ? 'c' : delta == 4 ? 'frame' : 'avatar';
      return chestBase(n,o,['festival','chests']) && festivalValid(next) && next.earnedTotal == prior.earnedTotal
        && (next.completedCycles == prior.completedCycles && next.mask > prior.mask
          || next.completedCycles == prior.completedCycles + 1 && next.mask == 0)
        && delta in [1,2,4,8] && int(prior.mask / delta) % 2 == 0 && prior.earnedTotal - prior.completedCycles * 100 >= threshold
        && (delta == 1 ? n.chests == o.chests : chestGain(n.chests,o.chests,type));
    }
    function validChestResult(r) {
      return r.keys().hasOnly(['chestType','gameId','poolVersion','kind','coins','reason','key','label','itemId','operation','sequence'])
