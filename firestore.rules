rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function knownSpace(space) { return space in ['production', 'beta', 'test', 'local', 'production-waves1', 'beta-waves1', 'test-waves1', 'local-waves1']; }
    function owner(uid) { return request.auth != null && request.auth.uid == uid; }
    function statisticsAdmin() { return request.auth != null && request.auth.token.admin == true; }
    function validStatistics(data) {
      return data.keys().hasOnly(['version', 'counterId', 'counters', 'totalPlayMs', 'trackedSince', 'updatedAt'])
        && data.keys().hasAll(['version', 'counterId', 'counters', 'totalPlayMs', 'trackedSince', 'updatedAt'])
        && data.counterId is string && data.counterId.matches('^[a-f0-9-]{36}$')
        && data.version == 1 && data.counters is map && data.counters.size() > 0 && data.counters.size() <= 128
        && data.totalPlayMs is int && data.totalPlayMs >= 0 && data.totalPlayMs <= 9007199254740991
        && data.trackedSince is int && data.trackedSince > 0 && data.trackedSince <= request.time.toMillis()
        && data.updatedAt == request.time;
    }
    function validCounterChange(next, previous) {
      let changed = next.counters.diff(previous.counters).affectedKeys();
      let key = next.counterId;
      let old = previous.counters.get(key, 0);
      let value = next.counters.get(key, -1);
      return changed.size() == 1 && changed.hasOnly([key])
        && value is int && value >= old && value <= 9007199254740991
        && next.totalPlayMs == previous.totalPlayMs + value - old
        && next.trackedSince <= previous.trackedSince;
    }
    match /gamespaces/{space}/profileStats/{uid} {
      allow get: if knownSpace(space) && (owner(uid) || statisticsAdmin());
      allow list: if knownSpace(space) && statisticsAdmin() && request.query.limit != null && request.query.limit <= 100;
      allow create: if knownSpace(space) && owner(uid) && validStatistics(request.resource.data)
        && request.resource.data.counters.size() == 1
        && validCounterChange(request.resource.data, {'counters': {}, 'totalPlayMs': 0, 'trackedSince': request.resource.data.trackedSince});
      allow update: if knownSpace(space) && owner(uid) && validStatistics(request.resource.data)
        && validCounterChange(request.resource.data, resource.data);
      allow delete: if false;
    }
    function validRoot(data) {
      return data.keys().hasOnly(['snapshotVersion', 'formatVersion', 'revision', 'manifest', 'fingerprint', 'byteLength', 'playerName', 'updatedAt', 'rewardRevision', 'economyRevision'])
        && data.keys().hasAll(['snapshotVersion', 'formatVersion', 'revision', 'manifest', 'fingerprint', 'byteLength', 'playerName', 'updatedAt'])
        && data.snapshotVersion == 1 && data.formatVersion == 2
        && data.revision is int && data.revision > 0
        && data.manifest is map && data.manifest.profile is list && data.manifest.profile.size() > 0
        && data.fingerprint is string && data.fingerprint.matches('^[a-f0-9]{64}$')
        && data.get('economyRevision',0) is int && data.get('economyRevision',0) >= 0 && data.get('economyRevision',0) <= 9007199254740991
        && data.byteLength is int && data.byteLength > 0 && data.byteLength <= 134217728
