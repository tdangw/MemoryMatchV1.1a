        && (!changed.hasAny(['V']) || rewardLetterCreditValue(n.counts.get('V',0),o.counts.get('V',0),n.earned.get('V',0),o.earned.get('V',0)))
        && (!changed.hasAny(['Y']) || rewardLetterCreditValue(n.counts.get('Y',0),o.counts.get('Y',0),n.earned.get('Y',0),o.earned.get('Y',0)));
    }
    function rewardEventProgress(n,o) {
      return n.keys().hasOnly(['id','week','points','day','dailyPoints','claimed']) && n.id == o.id && n.week == o.week && n.day == o.day
        && n.points is int && n.points >= o.points && n.points <= 100
        && n.dailyPoints is int && n.dailyPoints >= o.dailyPoints && n.dailyPoints <= 40
        && n.claimed is list && n.claimed.hasOnly([20,50,80]) && n.claimed.hasAll(o.claimed) && n.claimed.size() == n.claimed.toSet().size()
        && rewardEventClaims(n);
    }
    function rewardProgressFlush(n,o) {
      let changed = n.diff(o).affectedKeys();
      return changed.hasOnly(['letters','daily','weekly','event','tickets','ticketEarned','revision','rootRevision','fingerprint','updatedAt'])
        && n.revision == o.revision + 1 && n.updatedAt == request.time && n.day == int(request.time.toMillis() / 86400000)
        && n.daily.claimed == o.daily.claimed && n.weekly.claimed == o.weekly.claimed
        && (!changed.hasAny(['daily']) || rewardCounter(n.daily,['win-three','match-thirty','win-without-hint','bonus']) && monotoneCounter(n.daily,o.daily))
        && (!changed.hasAny(['weekly']) || rewardCounter(n.weekly,['bonus']) && monotoneCounter(n.weekly,o.weekly))
        && n.tickets is int && n.tickets >= 0 && n.tickets <= 9007199254740991
        && n.ticketEarned is int && n.ticketEarned >= o.ticketEarned && n.ticketEarned <= 9007199254740991
        && n.tickets == o.tickets + n.ticketEarned - o.ticketEarned
        && (!changed.hasAny(['event']) || rewardEventProgress(n.event,o.event))
        && (!changed.hasAny(['letters']) || rewardLetterCredit(n.letters,o.letters));
    }
    function rewardPeriodRollover(n,o) {
      let day = int(request.time.toMillis() / 86400000);
      let week = day - ((day + 3) % 7);
      let newWeek = week != o.week;
      let empty = {'wins':0,'matches':0,'noHint':0,'visits':0,'claimed':[]};
      return n.diff(o).affectedKeys().hasOnly(['revision','day','week','daily','weekly','spins','tickets','event','cosmetics','rootRevision','fingerprint','updatedAt'])
        && n.revision == o.revision + 1 && n.updatedAt == request.time && n.day == day && day > o.day && n.week == week
        && n.daily == empty && n.weekly == (newWeek ? empty : o.weekly)
        && n.spins.keys().hasOnly(['free','ads','pastAds','ticket']) && n.spins.free == null && n.spins.ads == [] && n.spins.ticket == o.spins.ticket
        && n.spins.pastAds is list && n.spins.pastAds.size() <= 30
        && n.spins.pastAds.toSet().difference(o.spins.pastAds.toSet().union(o.spins.ads.toSet())).size() == 0
        && (day > o.day + 3 || n.spins.pastAds.hasAll(o.spins.ads))
        && n.event == {'id':o.event.id,'week':week,'points':newWeek ? 0 : o.event.points,'day':day,'dailyPoints':0,'claimed':newWeek ? [] : o.event.claimed}
        && n.cosmetics == {'collectionId':o.cosmetics.collectionId,'week':week,'points':newWeek ? 0 : o.cosmetics.points,'granted':o.cosmetics.granted}
        && n.tickets is int && n.tickets >= 0 && n.tickets <= 9007199254740991 && rewardWallet(n,o);
    }
    function rewardInitial(n, space, uid) {
      let empty = {'wins':0,'matches':0,'noHint':0,'visits':0,'claimed':[]};
      let day = int(request.time.toMillis() / 86400000);
      return n.keys().hasOnly(['version','revision','day','week','daily','weekly','loginNext','loginDay','spins','tickets','ticketEarned','ticketSpent','event','cosmetics','letters','rootRevision','fingerprint','updatedAt'])
        && n.version == 1 && n.revision == 1 && n.day == day && n.week == day - ((day + 3) % 7)
        && n.daily == empty && n.weekly == empty && n.loginNext == 0 && n.loginDay == -1
        && n.spins == {'free':null,'ads':[],'pastAds':[],'ticket':null} && n.tickets == 0 && n.ticketEarned == 0 && n.ticketSpent == 0
        && n.event == {'id':'firefly-festival-01','week':n.week,'points':0,'day':day,'dailyPoints':0,'claimed':[]}
        && n.cosmetics == {'collectionId':'firefly-festival-01','week':n.week,'points':0,'granted':[]}
        && n.letters == {'counts':{},'earned':{},'sequence':0,'last':null}
        && n.updatedAt == request.time && rewardLinked(n,space,uid);
