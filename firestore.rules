          : r.kind == 'item' ? r.coins == 0 && r.itemId in (r.chestType == 'avatar' ? ["memory-avatar-sapphire-owl","memory-avatar-cherry-rabbit","memory-avatar-stellar-cat","memory-avatar-scholar-squirrel","memory-avatar-stargazer-hedgehog","memory-avatar-dreaming-deer","memory-avatar-galaxy-whale","memory-avatar-chestnut-squirrel","memory-avatar-snow-rabbit","memory-avatar-honey-bear","memory-avatar-dawn-crane","link-avatar-autumn-fox","link-avatar-moonfox","link-avatar-galaxy-deer","link-avatar-sailor-beaver","link-avatar-pearl-dolphin","link-avatar-azure-turtle","link-avatar-royal-seahorse","link-avatar-lantern-cat","link-avatar-festival-sparrow","link-avatar-paperblossom-deer","link-avatar-glasslight-fox","triple-avatar-jade-dragon","triple-avatar-blue-panda","triple-avatar-sunset-dragon","triple-avatar-quartz-phoenix","triple-avatar-amethyst-unicorn","triple-avatar-platinum-dragon","triple-avatar-crystal-mech-cat","triple-avatar-aurora-snowfox","triple-avatar-jade-penguin","triple-avatar-polar-bear","triple-avatar-galactic-dragon","letters-memory-avatar-moss-redpanda","letters-link-avatar-flower-fox","letters-triple-avatar-rose-dragon","letters-royal-avatar-dawn-lion","event-avatar-lantern-otter"] : (r.chestType == 'frame' ? ["memory-frame-golden-laurel","memory-frame-cherry-blossom","memory-frame-sky-feather","memory-frame-gilded-pages","memory-frame-astral-orbit","memory-frame-silken-clouds","memory-frame-knowledge-gateway","memory-frame-autumn-leaves","memory-frame-frosted-branch","memory-frame-golden-honeycomb","memory-frame-memory-crown","link-frame-moonblossom","link-frame-silver-moon","link-frame-stellar-orbit","link-frame-moon-coral","link-frame-silver-waves","link-frame-pearl-shell","link-frame-tidal-crown","link-frame-silk-lanterns","link-frame-osmanthus-branch","link-frame-moon-silk","link-frame-lantern-moon-gate","triple-frame-tri-crystal","triple-frame-prism","triple-frame-emerald","triple-frame-crystal-arch","triple-frame-three-wing-star","triple-frame-jade-gears","triple-frame-tri-star-crown","triple-frame-aurora-ribbon","triple-frame-azure-ice-ring","triple-frame-silver-meteor","triple-frame-aurora-crown","letters-memory-frame-memory-leaves","letters-link-frame-silk-lantern","letters-triple-frame-prism-glass","letters-royal-frame-journey-crown","event-frame-firefly-glow"] : (r.chestType == 'badge' ? ["memory-badge-wisdom","memory-badge-memory-master","memory-badge-wisdom-seal","memory-badge-memory-keeper","memory-badge-four-seasons","memory-badge-forest-guardian","link-badge-link-master","link-badge-golden-bond","link-badge-lighthouse-guide","link-badge-ocean-knot","link-badge-guiding-lantern","link-badge-moonlit-promise","triple-badge-crystal-triad","triple-badge-triad-master","triple-badge-triangle-seal","triple-badge-crystal-keeper","triple-badge-three-dawn-rays","triple-badge-aurora-heart","letters-memory-badge-folded-leaf","letters-link-badge-wish-knot","letters-triple-badge-prism-heart","letters-royal-badge-royal-seal"] : [])))
          : r.kind == 'support' && r.coins == 0 && r.key in (r.gameId == 'memory-match' ? ["hint","preview4","time30"] : (r.gameId == 'link-connect' ? ["hint","reshuffle","thunder","freeze"] : (r.gameId == 'triple-connect' ? ["hint","undo","shuffle","time"] : []))));
    }
    function rewardChestOpen(n,o) {
      let last = n.chests.last;
      return chestBase(n,o,['chests']) && n.chests.earned == o.chests.earned && n.chests.sourceEarned == o.chests.sourceEarned && chestCounts(n.chests)
        && n.chests.sequence == o.chests.sequence + 1 && last.sequence == n.chests.sequence && validChestResult(last)
