        && n.cosmetics.granted.hasAll(o.cosmetics.granted)
        && (n.cosmetics.granted == o.cosmetics.granted || n.cosmetics.points >= 100)
        && (!changed.hasAny(['tickets','ticketEarned','ticketSpent']) || rewardWallet(n,o))
        && (spent == 0 ? n.spins.ticket == o.spins.ticket : n.spins.ticket.sequence == n.ticketSpent && n.spins.ticket != o.spins.ticket)
