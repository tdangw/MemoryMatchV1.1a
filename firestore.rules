        && (!required.keys().hasAny(['C']) || rewardExchangeValue(n.counts.get('C',0),o.counts.get('C',0),required.get('C',0)))
        && (!required.keys().hasAny(['D']) || rewardExchangeValue(n.counts.get('D',0),o.counts.get('D',0),required.get('D',0)))
        && (!required.keys().hasAny(['E']) || rewardExchangeValue(n.counts.get('E',0),o.counts.get('E',0),required.get('E',0)))
        && (!required.keys().hasAny(['H']) || rewardExchangeValue(n.counts.get('H',0),o.counts.get('H',0),required.get('H',0)))
        && (!required.keys().hasAny(['I']) || rewardExchangeValue(n.counts.get('I',0),o.counts.get('I',0),required.get('I',0)))
        && (!required.keys().hasAny(['K']) || rewardExchangeValue(n.counts.get('K',0),o.counts.get('K',0),required.get('K',0)))
        && (!required.keys().hasAny(['L']) || rewardExchangeValue(n.counts.get('L',0),o.counts.get('L',0),required.get('L',0)))
        && (!required.keys().hasAny(['M']) || rewardExchangeValue(n.counts.get('M',0),o.counts.get('M',0),required.get('M',0)))
        && (!required.keys().hasAny(['N']) || rewardExchangeValue(n.counts.get('N',0),o.counts.get('N',0),required.get('N',0)))
        && (!required.keys().hasAny(['O']) || rewardExchangeValue(n.counts.get('O',0),o.counts.get('O',0),required.get('O',0)))
        && (!required.keys().hasAny(['P']) || rewardExchangeValue(n.counts.get('P',0),o.counts.get('P',0),required.get('P',0)))
        && (!required.keys().hasAny(['R']) || rewardExchangeValue(n.counts.get('R',0),o.counts.get('R',0),required.get('R',0)))
        && (!required.keys().hasAny(['T']) || rewardExchangeValue(n.counts.get('T',0),o.counts.get('T',0),required.get('T',0)))
        && (!required.keys().hasAny(['U']) || rewardExchangeValue(n.counts.get('U',0),o.counts.get('U',0),required.get('U',0)))
        && (!required.keys().hasAny(['V']) || rewardExchangeValue(n.counts.get('V',0),o.counts.get('V',0),required.get('V',0)))
        && (!required.keys().hasAny(['Y']) || rewardExchangeValue(n.counts.get('Y',0),o.counts.get('Y',0),required.get('Y',0)));
    }
    function rewardLetterUpdate(n,o) {
      return n.diff(o).affectedKeys().hasOnly(['letters','revision','rootRevision','fingerprint','updatedAt'])
        && n.revision == o.revision + 1 && n.updatedAt == request.time
        && n.day == int(request.time.toMillis() / 86400000)
        && (n.letters.last != null && n.letters.last.kind == 'exchange' ? rewardLetterExchange(n.letters,o.letters) : rewardLetters(n.letters,o.letters));
    }
    function rewardLetterCreditValue(amount, oldAmount, earned, oldEarned) {
      return amount is int && amount >= 0 && amount <= 9007199254740991
        && earned is int && earned >= oldEarned && earned <= 9007199254740991
        && amount == oldAmount + earned - oldEarned;
    }
    function rewardLetterCredit(n,o) {
      let changed = n.counts.diff(o.counts).affectedKeys().union(n.earned.diff(o.earned).affectedKeys());
      return n.keys().hasOnly(['counts','earned','sequence','last']) && n.sequence == o.sequence && n.last == o.last
        && n.counts.keys().hasOnly(['A','C','D','E','H','I','K','L','M','N','O','P','R','T','U','V','Y']) && n.earned.keys().hasOnly(['A','C','D','E','H','I','K','L','M','N','O','P','R','T','U','V','Y'])
        && (!changed.hasAny(['A']) || rewardLetterCreditValue(n.counts.get('A',0),o.counts.get('A',0),n.earned.get('A',0),o.earned.get('A',0)))
        && (!changed.hasAny(['C']) || rewardLetterCreditValue(n.counts.get('C',0),o.counts.get('C',0),n.earned.get('C',0),o.earned.get('C',0)))
        && (!changed.hasAny(['D']) || rewardLetterCreditValue(n.counts.get('D',0),o.counts.get('D',0),n.earned.get('D',0),o.earned.get('D',0)))
        && (!changed.hasAny(['E']) || rewardLetterCreditValue(n.counts.get('E',0),o.counts.get('E',0),n.earned.get('E',0),o.earned.get('E',0)))
        && (!changed.hasAny(['H']) || rewardLetterCreditValue(n.counts.get('H',0),o.counts.get('H',0),n.earned.get('H',0),o.earned.get('H',0)))
        && (!changed.hasAny(['I']) || rewardLetterCreditValue(n.counts.get('I',0),o.counts.get('I',0),n.earned.get('I',0),o.earned.get('I',0)))
        && (!changed.hasAny(['K']) || rewardLetterCreditValue(n.counts.get('K',0),o.counts.get('K',0),n.earned.get('K',0),o.earned.get('K',0)))
        && (!changed.hasAny(['L']) || rewardLetterCreditValue(n.counts.get('L',0),o.counts.get('L',0),n.earned.get('L',0),o.earned.get('L',0)))
        && (!changed.hasAny(['M']) || rewardLetterCreditValue(n.counts.get('M',0),o.counts.get('M',0),n.earned.get('M',0),o.earned.get('M',0)))
        && (!changed.hasAny(['N']) || rewardLetterCreditValue(n.counts.get('N',0),o.counts.get('N',0),n.earned.get('N',0),o.earned.get('N',0)))
        && (!changed.hasAny(['O']) || rewardLetterCreditValue(n.counts.get('O',0),o.counts.get('O',0),n.earned.get('O',0),o.earned.get('O',0)))
        && (!changed.hasAny(['P']) || rewardLetterCreditValue(n.counts.get('P',0),o.counts.get('P',0),n.earned.get('P',0),o.earned.get('P',0)))
        && (!changed.hasAny(['R']) || rewardLetterCreditValue(n.counts.get('R',0),o.counts.get('R',0),n.earned.get('R',0),o.earned.get('R',0)))
        && (!changed.hasAny(['T']) || rewardLetterCreditValue(n.counts.get('T',0),o.counts.get('T',0),n.earned.get('T',0),o.earned.get('T',0)))
