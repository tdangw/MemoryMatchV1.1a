rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function knownSpace(space) { return space in ['production', 'beta', 'test', 'local']; }
    function owner(uid) { return request.auth != null && request.auth.uid == uid; }
    function statisticsAdmin() { return request.auth != null && request.auth.token.admin == true; }
    function validStatistics(data) {
      return data.keys().hasOnly(['version', 'counterId', 'counters', 'totalPlayMs', 'trackedSince', 'updatedAt'])
        && data.keys().hasAll(['version', 'counterId', 'counters', 'totalPlayMs', 'trackedSince', 'updatedAt'])
        && data.counterId is string && data.counterId.matches('^[a-f0-9-]{36}$')
        && data.version == 1 && data.counters is map && data.counters.size() > 0 && data.counters.size() <= 128
        && data.totalPlayMs is int && data.totalPlayMs >= 0 && data.totalPlayMs <= 9007199254740991
        && data.trackedSince is int && data.trackedSince > 0 && data.trackedSince <= request.time.toMillis()
        && data.updatedAt == request.time;
    }
    function validCounterChange(next, previous) {
      let changed = next.counters.diff(previous.counters).affectedKeys();
      let key = next.counterId;
      let old = previous.counters.get(key, 0);
      let value = next.counters.get(key, -1);
      return changed.size() == 1 && changed.hasOnly([key])
        && value is int && value >= old && value <= 9007199254740991
        && next.totalPlayMs == previous.totalPlayMs + value - old
        && next.trackedSince <= previous.trackedSince;
    }
    match /gamespaces/{space}/profileStats/{uid} {
      allow get: if knownSpace(space) && (owner(uid) || statisticsAdmin());
      allow list: if knownSpace(space) && statisticsAdmin() && request.query.limit != null && request.query.limit <= 100;
      allow create: if knownSpace(space) && owner(uid) && validStatistics(request.resource.data)
        && request.resource.data.counters.size() == 1
        && validCounterChange(request.resource.data, {'counters': {}, 'totalPlayMs': 0, 'trackedSince': request.resource.data.trackedSince});
      allow update: if knownSpace(space) && owner(uid) && validStatistics(request.resource.data)
        && validCounterChange(request.resource.data, resource.data);
      allow delete: if false;
    }
    function validRoot(data) {
      return data.keys().hasOnly(['snapshotVersion', 'formatVersion', 'revision', 'manifest', 'fingerprint', 'byteLength', 'playerName', 'updatedAt'])
        && data.keys().hasAll(['snapshotVersion', 'formatVersion', 'revision', 'manifest', 'fingerprint', 'byteLength', 'playerName', 'updatedAt'])
        && data.snapshotVersion == 1 && data.formatVersion == 2
        && data.revision is int && data.revision > 0
        && data.manifest is map && data.manifest.profile is list && data.manifest.profile.size() > 0
        && data.fingerprint is string && data.fingerprint.matches('^[a-f0-9]{64}$')
        && data.byteLength is int && data.byteLength > 0 && data.byteLength <= 134217728
        && data.playerName is string && data.playerName.size() > 0 && data.playerName.size() <= 40
        && data.updatedAt == request.time;
    }
    function validObject(data, hash) {
      return hash.matches('^[a-f0-9]{64}$')
        && data.keys().hasOnly(['snapshotVersion', 'payload', 'byteLength', 'stageId', 'createdAt'])
        && data.keys().hasAll(['snapshotVersion', 'payload', 'byteLength', 'stageId', 'createdAt'])
        && data.snapshotVersion == 1 && data.payload is string && data.payload.size() > 0 && data.payload.size() <= 90000
        && data.byteLength is int && data.byteLength > 0 && data.byteLength <= 65536
        && data.stageId is string && data.stageId.matches('^[a-f0-9-]{36}$') && data.createdAt == request.time;
    }
    match /gamespaces/{space}/players/{uid} {
      allow get: if knownSpace(space) && owner(uid);
      allow list, delete: if false;
      allow create: if knownSpace(space) && owner(uid) && validRoot(request.resource.data) && request.resource.data.revision == 1;
      allow update: if knownSpace(space) && owner(uid) && validRoot(request.resource.data)
        && request.resource.data.revision == resource.data.revision + 1;
      match /objects/{hash} {
        allow get: if knownSpace(space) && owner(uid);
        allow list: if false;
        allow create: if knownSpace(space) && owner(uid) && validObject(request.resource.data, hash);
        allow update: if knownSpace(space) && owner(uid) && validObject(request.resource.data, hash)
          && request.resource.data.payload == resource.data.payload && request.resource.data.byteLength == resource.data.byteLength;
        allow delete: if knownSpace(space) && owner(uid);
      }
    }
    function validEntry(data, board) {
      return data.rulesVersion == 3 ? validProgressEntry(data, board) : data.rulesVersion in [1, 2] && data.resultId is string && data.resultId.matches('^[a-f0-9-]{36}$')
        && data.gameId in ['memory-match', 'link-connect', 'triple-connect']
        && data.playerName is string && data.playerName.size() > 0 && data.playerName.size() <= 40
        && data.updatedAt == request.time
        && (data.kind == 'time'
          ? data.rulesVersion == 1 && data.keys().hasOnly(['rulesVersion', 'resultId', 'gameId', 'mode', 'kind', 'playerName', 'updatedAt', 'level', 'durationMs', 'score', 'stars'])
            && data.mode in ['easy', 'normal', 'hard', 'superHard']
            && data.level is int && data.level > 0 && data.level <= 9007199254740900
            && board == 'v1_' + data.gameId + '_' + data.mode + '_' + string(data.level)
            && data.durationMs is int && data.durationMs > 0 && data.durationMs <= 9007199254740991
            && data.score is int && data.score >= 0 && data.score <= 9007199254740991
            && data.stars is int && data.stars >= 0 && data.stars <= 3
          : data.kind == 'run' && data.keys().hasOnly(['rulesVersion', 'resultId', 'gameId', 'mode', 'kind', 'playerName', 'updatedAt', 'levelReached', 'totalScore', 'outcome'])
            && (data.mode == 'challenge' || data.mode == 'endless' && (data.rulesVersion == 2 || data.gameId == 'triple-connect'))
            && board == 'v' + string(data.rulesVersion) + '_' + data.gameId + '_' + data.mode
            && data.levelReached is int && data.levelReached > 0 && data.levelReached <= 9007199254740991
            && data.totalScore is int && data.totalScore >= 0 && data.totalScore <= 9007199254740991
            && (data.rulesVersion == 2 ? data.outcome == 'won' : data.outcome in ['won', 'lost']));
    }
    function validProgressEntry(data, board) {
      return data.keys().hasOnly(['rulesVersion', 'resultId', 'gameId', 'family', 'kind', 'playerName', 'reachedAt', 'levelReached'])
        && data.keys().hasAll(['rulesVersion', 'resultId', 'gameId', 'family', 'kind', 'playerName', 'reachedAt', 'levelReached'])
        && data.resultId is string && data.resultId.matches('^[a-f0-9-]{36}$') && data.kind == 'progress'
        && data.gameId in ['memory-match', 'link-connect', 'triple-connect'] && data.family in ['adventure', 'challenge', 'endless']
        && board == 'v3_' + data.gameId + '_' + data.family
        && data.playerName is string && data.playerName.size() > 0 && data.playerName.size() <= 40
        && data.levelReached is int && data.levelReached > 0 && data.levelReached <= 9007199254740900
        && data.reachedAt == request.time;
    }
    function betterEntry(next, previous) {
      return next.kind == previous.kind && (next.kind == 'progress' ? next.levelReached > previous.levelReached : next.kind == 'time' ? next.durationMs < previous.durationMs
        : next.levelReached > previous.levelReached || next.levelReached == previous.levelReached && next.totalScore > previous.totalScore);
    }
    match /gamespaces/{space}/leaderboards/{board}/entries/{uid} {
      allow get: if knownSpace(space);
      allow list: if knownSpace(space) && request.query.limit != null && request.query.limit <= 20;
      allow create: if knownSpace(space) && owner(uid) && validEntry(request.resource.data, board);
      allow update: if knownSpace(space) && owner(uid) && validEntry(request.resource.data, board) && betterEntry(request.resource.data, resource.data);
      allow delete: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
