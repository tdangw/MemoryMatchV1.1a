        && n.event.claimed is list && n.event.claimed.hasOnly([20,50,80]) && n.event.claimed.size() == n.event.claimed.toSet().size())
        && (!changed.hasAny(['cosmetics']) || n.cosmetics is map && n.cosmetics.keys().hasOnly(['collectionId','week','points','granted'])
        && n.cosmetics.collectionId == 'firefly-festival-01' && n.cosmetics.week == n.week && (n.cosmetics.points is int && n.cosmetics.points >= 0) && n.cosmetics.points <= 100
