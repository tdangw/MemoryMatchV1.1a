    function letterRequirementMap(setId) { return setId == 'memory-match' ? {"M":3,"E":1,"O":1,"R":1,"Y":1,"A":1,"T":1,"C":1,"H":1} : setId == 'link-connect' ? {"L":1,"I":1,"N":3,"K":1,"C":2,"O":1,"E":1,"T":1} : setId == 'triple-connect' ? {"T":2,"R":1,"I":1,"P":1,"L":1,"E":2,"C":2,"O":1,"N":2} : setId == 'adventure' ? {"A":1,"D":1,"V":1,"E":2,"N":1,"T":1,"U":1,"R":1} : {}; }
    function rewardExchangeValue(next,old,needed) { return next is int && next >= 0 && next == old - needed; }
    function rewardLetterExchange(n,o) {
      let required = letterRequirementMap(n.last.setId);
      return n.keys().hasOnly(['counts','earned','sequence','last']) && n.earned == o.earned
        && n.sequence == o.sequence + 1 && n.last.sequence == n.sequence
        && n.last.keys().hasOnly(['kind','setId','itemId','coins','sequence','operation']) && n.last.kind == 'exchange'
        && n.last.setId in ["memory-match","link-connect","triple-connect","adventure"] && n.last.operation is string && n.last.operation.matches('^[A-Za-z0-9_-]{1,128}$')
        && (n.last.itemId == null ? n.last.coins == 10000 : n.last.itemId in ["letters-memory-avatar-moss-redpanda","letters-memory-frame-memory-leaves","letters-memory-badge-folded-leaf","letters-link-avatar-flower-fox","letters-link-frame-silk-lantern","letters-link-badge-wish-knot","letters-triple-avatar-rose-dragon","letters-triple-frame-prism-glass","letters-triple-badge-prism-heart","letters-royal-avatar-dawn-lion","letters-royal-frame-journey-crown","letters-royal-badge-royal-seal"] && n.last.coins == 0)
        && n.counts.diff(o.counts).affectedKeys().hasOnly(required.keys())
